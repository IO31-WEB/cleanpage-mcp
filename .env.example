# CleanPage — environment configuration
#
# Non-secret values below are set as [vars] in wrangler.toml and deployed
# with the Worker. This file documents them in one place and is the format
# to use if you ever run this outside Cloudflare Workers (e.g. adapting the
# Hono app to Vercel/Node). Copy to `.env` for that use case; for Cloudflare
# Workers, edit wrangler.toml directly instead (Workers doesn't read .env).

# --- Payments -----------------------------------------------------------

# Wallet address on Base that receives USDC payments. Required.
# This only needs to be a public address — settlement uses USDC's EIP-3009
# transferWithAuthorization, so no private key is ever held by this service.
PAYMENT_ADDRESS=0xYourBaseWalletAddressHere

# "base" for mainnet USDC, "base-sepolia" for testnet during development.
X402_NETWORK=base-sepolia

# x402 facilitator that verifies and settles payments on your behalf.
# x402.org/facilitator works out of the box for base-sepolia. For mainnet,
# use a production facilitator (e.g. Coinbase's, once you have credentials)
# or self-host one.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Price per successful clean_page call, in USD.
CLEAN_PAGE_PRICE_USD=0.02

# --- Deployment -----------------------------------------------------------

# Public URL this service is deployed at (used in agent.json, mcp.json,
# llms.txt, and Open Graph tags). Must match your actual domain.
PUBLIC_BASE_URL=https://cleanpage.example.com

# --- Rate limiting & abuse protection --------------------------------------

# Max free-tier (health/list_capabilities/pricing) calls per IP per minute.
FREE_RATE_LIMIT_PER_MIN=30

# --- Optional LLM enrichment ------------------------------------------------

# Enables structured_facts extraction via a cheap LLM call when a caller
# passes options.extract_facts=true. If false (or ANTHROPIC_API_KEY is
# unset), clean_page still works fully — structured_facts is just empty.
ENABLE_LLM_ENRICHMENT=true
LLM_MODEL=claude-haiku-4-5-20251001

# --- Secrets (set via `wrangler secret put NAME`, never committed) --------

# Required only if ENABLE_LLM_ENRICHMENT=true.
ANTHROPIC_API_KEY=sk-ant-...
